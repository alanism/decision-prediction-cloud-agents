{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-decision-lab.invalid/schemas/assumption-register.v1.schema.json",
  "title": "Assumption Register v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "register_id", "assumptions"],
  "properties": {
    "contract_version": {"const": "nhi.assumption_register.v1"},
    "register_id": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "name", "value", "unit", "provenance_class"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string"},
          "provenance_class": {"const": "assumed"},
          "input_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
