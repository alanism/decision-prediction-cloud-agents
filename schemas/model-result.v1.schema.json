{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-decision-lab.invalid/schemas/model-result.v1.schema.json",
  "title": "Model Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "result_id",
    "model_id",
    "model_family",
    "model_version",
    "input_hash",
    "data",
    "metadata",
    "limitations"
  ],
  "properties": {
    "contract_version": {"const": "nhi.model_result.v1"},
    "result_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "enum": ["power_law", "markov", "bass", "bandit"]},
    "model_version": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "data": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/evidence_atom"}
    },
    "metadata": {
      "type": "object",
      "required": ["algorithm_version", "seed"],
      "properties": {
        "algorithm_version": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "string"]}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "evidence_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance_class"],
      "properties": {
        "value": {},
        "provenance_class": {
          "enum": ["measured", "assumed", "calculated", "modeled", "forecast", "decided", "unavailable"]
        },
        "unit": {"type": "string"},
        "input_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "formula_ref": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "required": ["provenance_class"],
            "properties": {"provenance_class": {"const": "unavailable"}}
          },
          "then": {
            "required": ["reason"],
            "properties": {"value": {"type": "null"}}
          }
        }
      ]
    }
  }
}
