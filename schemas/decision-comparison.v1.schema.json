{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-decision-lab.invalid/schemas/decision-comparison.v1.schema.json",
  "title": "Decision Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "comparison_id", "analysis_refs", "data", "disclaimer", "canonical_hash"],
  "properties": {
    "contract_version": {"const": "nhi.decision_comparison.v1"},
    "comparison_id": {"type": "string", "minLength": 1},
    "analysis_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysis_id", "canonical_hash"],
        "properties": {
          "analysis_id": {"type": "string", "minLength": 1},
          "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/evidence_atom"}
    },
    "disclaimer": {"const": "comparison only, not financial advice"},
    "report_sections": {"type": "object"},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "evidence_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance_class"],
      "properties": {
        "value": {},
        "provenance_class": {
          "enum": ["measured", "assumed", "calculated", "modeled", "forecast", "decided", "unavailable"]
        },
        "unit": {"type": "string"},
        "input_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "formula_ref": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "required": ["provenance_class"],
            "properties": {"provenance_class": {"const": "unavailable"}}
          },
          "then": {
            "required": ["reason"],
            "properties": {"value": {"type": "null"}}
          }
        }
      ]
    }
  }
}
